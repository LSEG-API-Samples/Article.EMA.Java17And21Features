{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Maven Tests",
            "type": "process",
            "command": "mvn",
            "args": ["test"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Maven Clean Package",
            "type": "process",
            "command": "mvn",
            "args": ["clean", "package"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        }
    ]
}
